/* =========================
   STOCK GLOBAL WMS
========================= */

function getStock(){
  return JSON.parse(localStorage.getItem("stock") || "{}");
}

function saveStock(stock){
  localStorage.setItem("stock", JSON.stringify(stock));
}

/* =========================
   INIT STOCK
========================= */

function initStock(produits){

  let stock = getStock();

  produits.forEach(p => {

    if(!stock[p.emp]){
      stock[p.emp] = {
        rack: Math.floor(Math.random()*50)+20,
        pick: Math.floor(Math.random()*10)+5
      };
    }

  });

  saveStock(stock);
}

/* =========================
   CONSOMMATION (PREPA)
========================= */

function takeStock(emp, qty){

  let stock = getStock();

  if(!stock[emp]){
    stock[emp] = {rack:0,pick:0};
  }

  if(stock[emp].pick < qty){
    return false;
  }

  stock[emp].pick -= qty;

  saveStock(stock);
  return true;
}

/* =========================
   REAPPRO (CARISTE)
========================= */

function addStock(emp, qty){

  let stock = getStock();

  if(!stock[emp]){
    stock[emp] = {rack:0,pick:0};
  }

  stock[emp].rack += qty;
  stock[emp].pick += qty;

  saveStock(stock);
}

/* =========================
   LECTURE STOCK
========================= */

function readStock(emp){
  let stock = getStock();
  return stock[emp] || {rack:0,pick:0};
}
